<h1><%= @feature.title %></h1>
<p><%= @feature.description %></p>

<h2>User Stories</h2>

<% @stories.each do |story| %>
  <div>
    <h3>
      <%= link_to story.title, story_path(story) %>
    </h3>
    <p><%= story.description %></p>

    <strong>Acceptance Criteria:</strong>
    <p><%= story.acceptance_criteria %></p>
  </div>
<% end %>
