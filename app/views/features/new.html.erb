<h1>New Feature</h1>

<%= form_with model: @feature do |f| %>
  <div>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :priority %><br>
    <%= f.select :priority, ["P0", "P1", "P2"] %>
  </div>

  <div>
    <%= f.label :status %><br>
    <%= f.select :status, ["Planned", "In Progress", "Done"] %>
  </div>

  <%= f.submit "Create Feature" %>
<% end %>
